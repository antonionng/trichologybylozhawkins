## Local development: copy to `.env.local` and edit (file is gitignored).

# Database / cache (matches trichology/docker-compose.yml when using default DB name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lorrainehawkins?schema=public
REDIS_URL=redis://localhost:6379

# Auth (set in production; dev optional but avoids session issues)
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Public URL (production: https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
DEV_SKIP_CHECKOUT=false

# OpenAI (optional in dev)
OPENAI_API_KEY=

# Resend: without RESEND_API_KEY, email sends are skipped and the server logs a warning.
# SHOP_ADMIN_NOTIFY_EMAILS and CHAT_ADMIN_NOTIFY_EMAIL are bootstrap fallbacks only.
# After setup, manage operational recipients in Dashboard → Email → Operational Settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lorraine Hawkins <noreply@trichologyacademy.co.uk>"
SHOP_ADMIN_NOTIFY_EMAILS=ops@example.com,shop@example.com
CHAT_ADMIN_NOTIFY_EMAIL=ops@example.com

# Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=replace_me

# Optional one-time admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=
