## Local development template
## Copy this file to `.env.local` and edit as needed.

# Database / cache (matches trichology/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lorrainehawkins?schema=public
REDIS_URL=redis://localhost:6379

# Auth (dev can run without this, but setting it avoids session resets)
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (can be dummy values locally unless you test Stripe flows)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# OpenAI (optional in dev unless you test the chat assistant)
OPENAI_API_KEY=

# Supabase (required by env schema; can be placeholders unless you test uploads)
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=replace_me

# Optional: one-time admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=

