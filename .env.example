# Copy to `.env.local` for local dev (never commit `.env.local`).
# For Vercel: Project Settings → Environment Variables (use Production / Preview as needed).

## Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lorrainehawkins?schema=public"

## Caching / queues
REDIS_URL="redis://localhost:6379"

## Auth (required in production)
AUTH_SECRET="replace-with-openssl-rand-hex-32"

## Application URL (local dev). Production canonical host is https://trichologyacademy.co.uk
## Do not set this to https://trichology.vercel.app — sitemap, robots, OG, and JSON-LD remap that host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

## Optional: home + about hero image URL (overrides public/images/hero-placeholder.png)
# NEXT_PUBLIC_LORRAINE_HERO_URL="https://your-cdn.example/lorraine-hero.jpg"

## Supabase (uploads / signed URLs)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_me"
SUPABASE_STORAGE_BUCKET="education-assets"

## Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
DEV_SKIP_CHECKOUT="false"

## OpenAI (optional locally)
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""

## Resend (quiz results, shop, academy signup, purchase receipts, enquiries). Required in production (schema check).
## In Resend: verify your sending domain, then set RESEND_FROM_EMAIL to an address on that domain.
## If the key is missing, sends are skipped. If the key is set but "from" is wrong, Resend returns an error (now logged / thrown).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lorraine Hawkins <noreply@your-verified-domain.com>"
## Bootstrap fallback only. After first admin login, manage operational admin recipients in Dashboard → Email → Operational Settings.
## Used only until the NotificationSettings row exists in the database.
SHOP_ADMIN_NOTIFY_EMAILS="ops@example.com,shop@example.com"
CHAT_ADMIN_NOTIFY_EMAIL="ops@example.com"

## Optional admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=""
