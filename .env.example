# Copy to `.env.local` for local dev (never commit `.env.local`).
# For Vercel: Project Settings → Environment Variables (use Production / Preview as needed).

## Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lorrainehawkins?schema=public"

## Caching / queues
REDIS_URL="redis://localhost:6379"

## Auth (required in production)
AUTH_SECRET="replace-with-openssl-rand-hex-32"

## Application URL (use your production domain in Vercel Production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

## Supabase (uploads / signed URLs)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_me"
SUPABASE_STORAGE_BUCKET="education-assets"

## Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
DEV_SKIP_CHECKOUT="false"

## OpenAI (optional locally)
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""

## Resend (quiz results, shop, notifications). Use a verified domain sender in production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lorraine Hawkins <noreply@trichologyacademy.com>"
SHOP_ADMIN_NOTIFY_EMAILS="ops@example.com,shop@example.com"

## Optional admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=""
