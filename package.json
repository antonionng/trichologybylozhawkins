    "prisma:migrate": "prisma migrate dev",
    "seed:user": "npx tsx scripts/seed-user.ts",
    "seed:shop": "npx tsx scripts/seed-shop-catalog.ts",
    "pretest": "prisma generate",
    "test": "vitest",
    "postinstall": "prisma generate",
    "ingest:extract": "npx tsx scripts/ingest/extract-content.ts",
    "ingest:structure": "npx tsx scripts/ingest/structure-courses.ts",
    "ingest": "npm run ingest:extract && npm run ingest:structure"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
