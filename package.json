    "bullmq": "^5.8.10",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.27",
    "ioredis": "^5.4.1",
    "next": "14.2.5",
    "openai": "^4.56.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "resend": "^4.3.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^16.10.0",
    "zod": "^3.23.8"
  },
