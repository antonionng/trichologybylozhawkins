## Lorraine Hawkins / Trichology Platform - Example Environment
## Copy into your `.env.local` (or your hosting provider's env settings).
##
## NOTE:
## - In dev, the app will generate a temporary AUTH_SECRET if omitted (sessions reset on restart).
## - In production, you MUST set AUTH_SECRET.

# Database / cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=redis://:PASSWORD@HOST:6379

# Auth (session signing)
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Public URL (used for redirects / stripe callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DEV_SKIP_CHECKOUT=false

# OpenAI
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Lorraine Hawkins <no-reply@trichologybylorrainehawkins.co.uk>"

# Supabase (storage + server-side access)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Optional: one-time admin bootstrap (enables /api/admin/bootstrap)
ADMIN_BOOTSTRAP_TOKEN=optional-strong-token



